# --- Database -----------------------------------------------------------------
# Full-access connection (admin, finance, seed). Owns both `public` and `internal` schemas.
DATABASE_URL="postgresql://dc_admin:change-me@localhost:5432/degreecomplete?schema=public"
# Restricted connection used by every public page/API. This role has NO grants on the `internal` schema
# (see db/roles.sql). Even a coding mistake cannot read payout data through it.
DATABASE_URL_PUBLIC="postgresql://dc_public:change-me@localhost:5432/degreecomplete?schema=public"

# --- Auth ---------------------------------------------------------------------
SESSION_SECRET="generate-a-64-char-random-string"
SESSION_TTL_HOURS="12"

# --- Business contact (from the owner's creatives) ----------------------------
NEXT_PUBLIC_BUSINESS_PHONE="+919833074476"
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY="98 33 07 44 76"
NEXT_PUBLIC_WHATSAPP_NUMBER="919833074476"
NEXT_PUBLIC_SITE_URL="https://www.degreecomplete.in"
NEXT_PUBLIC_SITE_NAME="DegreeComplete.in"

# --- Analytics (leave blank to disable) ---------------------------------------
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- Email — lead notification via Google Apps Script -------------------------
# Deploy the Apps Script as a web app and paste the URL here.
# Leave blank to skip email notifications (leads are still saved in the DB).
GOOGLE_SCRIPT_URL=""

# --- File storage --------------------------------------------------------------
# local | s3   (s3 needs the AWS_* vars; local writes to ./storage — never inside /public)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
AWS_S3_BUCKET=""
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
